{
  "name": "claude-team-monitor",
  "version": "0.2.0",
  "description": "Claude Code 팀장/팀원 세션을 한 화면에서 모니터링·관리하는 데스크톱 앱(Tauri). src/main.ts의 Electron 구현은 참고용으로만 남겨 둔 것이다.",
  "private": true,
  "license": "MIT",
  "author": "Julian",
  "repository": {
    "type": "git",
    "url": "https://github.com/gyeongho-you/claude-team-monitor.git"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "build:mcp": "esbuild src/mcp/teamMemberServer.ts --bundle --platform=node --outfile=dist/teamMemberServer.js",
    "build": "npm run typecheck && npm run build:mcp",
    "build:electron": "npm run typecheck && esbuild src/main.ts src/preload.ts --bundle --platform=node --external:electron --outdir=dist && npm run build:mcp",
    "electron:start": "npm run build:electron && electron .",
    "electron:dist:win": "npm run build:electron && electron-builder --win portable",
    "electron:dist:win:msi": "npm run build:electron && electron-builder --win msi",
    "electron:dist:mac": "npm run build:electron && electron-builder --mac dmg",
    "electron:pack:win": "npm run build:electron && electron-packager . \"Claude Team Monitor\" --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"^/src($|/)\" --ignore=\"^/tests($|/)\" --ignore=\"^/release($|/)\" --ignore=\"^/tsconfig.json$\" --ignore=\"^/package-lock.json$\" --ignore=\"^/[.]claude($|/)\" --ignore=\"^/node_modules($|/)\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "tauri:build:release": "tauri build --config src-tauri/tauri.release.conf.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-packager": "^17.1.2",
    "esbuild": "0.25.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "net.g1project.claude-team-monitor",
    "productName": "Claude Team Monitor",
    "directories": {
      "output": "dist-builder"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  }
}
